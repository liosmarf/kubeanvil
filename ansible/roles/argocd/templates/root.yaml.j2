# {{ ansible_managed }}
# The only Application created outside Git. It renders the platform chart with this
# cluster's values, which in turn creates one Application per selected component.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root
  namespace: {{ argocd_namespace }}
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: {{ argocd_repo_url }}
    targetRevision: {{ argocd_repo_revision }}
    path: {{ argocd_platform_path }}
    helm:
      valueFiles:
        - {{ argocd_cluster_values | relpath(argocd_platform_path) }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ argocd_namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
