apiVersion: v1
kind: Secret
metadata:
  name: gitops-repository
  namespace: {{ argocd_namespace }}
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: {{ argocd_repo_url }}
{% if argocd_repo_credentials.ssh_private_key is defined %}
  sshPrivateKey: |
    {{ argocd_repo_credentials.ssh_private_key | indent(4) }}
{% else %}
  username: {{ argocd_repo_credentials.username }}
  password: {{ argocd_repo_credentials.password }}
{% endif %}
