# Secrets the platform needs from the start, from secrets.sops.yaml (ADR 0002).
{% set s = argocd_bootstrap_secrets %}
{% if s.cloudflareApiToken | default('') %}
{% for namespace in ['cert-manager', 'external-dns'] %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token
  namespace: {{ namespace }}
stringData:
  api-token: {{ s.cloudflareApiToken | to_json }}
{% endfor %}
{% endif %}
{% if s.backupS3 is defined and s.backupS3 %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: velero
---
apiVersion: v1
kind: Secret
metadata:
  name: velero-s3
  namespace: velero
stringData:
  cloud: |
    [default]
    aws_access_key_id={{ s.backupS3.accessKeyId }}
    aws_secret_access_key={{ s.backupS3.secretAccessKey }}
{% endif %}
